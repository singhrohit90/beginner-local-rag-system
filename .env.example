# Copy to .env (gitignored) and fill in what you use. Nothing here is required.

# Which models the experiments use when no --llm / --judge flag is given.
#   vllm:<model id>     the on-prem vLLM server (OpenAI-compatible API, reached over the SSH tunnel)
#   ollama:<model>      a model served by local Ollama
#   gemini:<model>      Google Gemini API (needs GEMINI_API_KEY)
RAG_LLM=vllm:/models/gpt-oss-20b
RAG_JUDGE=ollama:qwen2.5:7b

# On-prem vLLM server. The SSH tunnel (PuTTY) must be connected first.
# The tunnel binds to 127.22.10.1, not localhost.
REMOTE_URL=http://127.22.10.1:30007/v1
# REMOTE_API_KEY=            # only if the server ever requires one
# REMOTE_REASONING_BUDGET=3000   # extra tokens allowed for a reasoning model's thinking
# REMOTE_REASONING_EFFORT=low    # low, medium or high; lower is faster and cheaper

# GEMINI_API_KEY=

# Where chunks and vectors live. memory: rebuilt from data/uploads after a restart (default).
# opensearch: kept in the database started with `docker compose up -d opensearch`.
# RAG_STORE=memory
# RAG_OPENSEARCH_URL=http://127.0.0.1:9200

# Spotlight prompt nonce. Random per process by default. Set a fixed value only to make runs
# repeatable (the LLM cache keys on the prompt); it is a secret, so keep it out of git.
# RAG_NONCE_KEY=

# API request checks (see docs/auth_plan.md): host names the server answers to, and extra browser origins
# RAG_ALLOWED_HOSTS=127.0.0.1,localhost
# RAG_ALLOWED_ORIGINS=

# Conversation rewrite step: turns a follow-up into a standalone question before retrieval, asks one
# clarifying question when a follow-up is ambiguous, and starts a clean history on a new topic.
# "1" turns it on; it is off by default until it is measured.
# RAG_REWRITE=
# The model that rewrites, written like RAG_LLM (default ollama:qwen2.5:7b). OLLAMA_KEEP_ALIVE is an
# Ollama server setting, not one of ours: an idle model unloads after about five minutes and the next
# call waits for it to load (measured at about 30 seconds on this machine).
# RAG_REWRITER=
